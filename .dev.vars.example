# Copy to .dev.vars for local development (never commit .dev.vars).
# Production: set these with `wrangler secret put <NAME>`.

# Clerk (dashboard.clerk.com -> API keys)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk webhook signing secret. OPTIONAL for local dev — billing state is also
# mirrored on dashboard load, and Clerk can't reach localhost without a tunnel,
# so you can leave this blank locally.
# To enable: Clerk dashboard -> Configure -> Webhooks -> Add Endpoint
#   URL:    https://<your-domain>/api/webhooks/clerk   (prod: https://day3.app/...)
#   Events: organization.updated, organization.deleted,
#           subscriptionItem.active, subscriptionItem.pastDue, subscriptionItem.ended
# Then copy the endpoint's "Signing Secret" (whsec_...) here.
CLERK_WEBHOOK_SIGNING_SECRET=

# Long random string used to sign unsubscribe tokens.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=

# Comma-separated list of admin email addresses.
ADMIN_EMAILS=you@example.com
