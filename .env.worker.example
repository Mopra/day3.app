# Background tier (BullMQ worker on the VPS). Copy to the worker host's `.env`
# (or your secret manager). The worker consumes Redis, sends via SES, and runs
# the cron sweeps (stuck-send recovery, campaign reconcile, and the pending
# domain verification re-check). It needs no Clerk keys (no inbound auth) or
# NEXT_PUBLIC_* vars.

# --- Database (Supabase Postgres) ---
# The worker is long-lived → use the DIRECT/session connection, port 5432.
DATABASE_URL=postgres://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres

# --- Queue (Redis + BullMQ, TLS) ---
REDIS_URL=rediss://default:<password>@<vps-host>:6379

# --- App ---
# REQUIRED. Validated at startup by src/lib/env.ts (worker profile): the worker
# refuses to boot without DATABASE_URL + UNSUBSCRIBE_SECRET (and AWS_REGION when
# EMAIL_PROVIDER=ses). UNSUBSCRIBE_SECRET must be >=16 chars and MUST match the
# web tier so signed unsubscribe links verify and resolve. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The worker does NOT need OAUTH_STATE_SECRET, DNS_TOKEN_ENC_KEY, or Clerk keys.
UNSUBSCRIBE_SECRET=
# MUST be the app domain that actually serves /unsubscribe (the Next app runs on
# go.day3.app; the apex day3.app is the marketing site and has no /unsubscribe).
# A wrong value here ships dead unsubscribe links — see docs/pre-launch-checklist.md.
APP_URL=https://go.day3.app
# Absolute base for signup-form confirmation links the worker emails. Forms live
# under /f on the app domain, so this is just the app URL. Falls back to APP_URL
# when unset, so you normally don't need to set it.
# FORMS_URL=https://go.day3.app

# --- Supabase Storage (reads uploaded CSVs during imports) ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Amazon SES v2) ---
# Production uses `ses` (SES is production-approved). Keep `mock` for local dev.
# Under `ses` the worker requires AWS_REGION (+ the credentials below).
EMAIL_PROVIDER=mock          # mock (local dev) | ses (production)
# AWS_REGION + credentials are ALSO required for the cron's pending-domain
# verification re-check (GetEmailIdentity) — domain verification uses SES even if
# EMAIL_PROVIDER sends via another provider. Without AWS_REGION the re-check is
# skipped (no-op), so domains only sync while the user has the setup page open.
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=day3-default

# --- Campaign risk review ---
# Deterministic content checks ALWAYS run. Set AI_REVIEW_MODE=ai to layer an AI
# pass on top (via OpenRouter): it can only ESCALATE the deterministic result
# (prompt injection in campaign content can't lower it) and FAILS OPEN — a model
# error/timeout falls back to the deterministic verdict, never wedging a send.
# Cost: one call per campaign submission on a small model (~fractions of a cent);
# not charged against any org's AI budget. Requires OPENROUTER_API_KEY (the
# worker refuses to boot with mode=ai and no key).
AI_REVIEW_MODE=mock          # mock (deterministic only) | ai (deterministic + AI pass)
# OPENROUTER_API_KEY=
# OPENROUTER_RISK_MODEL=anthropic/claude-haiku-4.5   # default; keep it a cheap model

# --- Send throughput tuning ---
# A campaign is sent by fanning out SEND_LANES independent self-chaining batches,
# each claiming a disjoint slice of recipients (FOR UPDATE SKIP LOCKED — safe
# under true concurrency). Effective parallelism is
#   min(SEND_LANES, WORKER_CONCURRENCY × worker replicas).
# Tune toward your APPROVED SES max send rate (a serial lane sustains roughly one
# send per network round-trip, ~6–10/s; 8 lanes ≈ 50–80/s). Raise all three for
# big lists; keep DB_POOL_MAX ≥ WORKER_CONCURRENCY.
# WORKER_CONCURRENCY=8   # concurrent jobs this worker processes (default 8)
# SEND_LANES=8           # parallel send lanes per campaign (default 8, max 64)
# SEND_BATCH_SIZE=100    # recipients claimed+sent per batch (default 100)
# DB_POOL_MAX=20         # worker Postgres pool size (default 20)

# --- Observability (optional; see src/lib/logger.ts) ---
# Structured JSON logging is always on. LOG_LEVEL gates verbosity
# (debug|info|warn|error; default info). Each job logs start/finish/duration
# with its type + entity id and a per-job correlation id. ERROR_REPORTING_DSN
# (or SENTRY_DSN) turns on the error sink: failed/dead-lettered jobs are POSTed
# there as redacted JSON (stack + safe context, never secrets). Unset → no-op.
# LOG_LEVEL=info
# ERROR_REPORTING_DSN=
