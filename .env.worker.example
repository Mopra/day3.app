# Background tier (BullMQ worker on the VPS). Copy to the worker host's `.env`
# (or your secret manager). The worker consumes Redis, sends via SES, and runs
# the cron sweeps. It needs no Clerk keys (no inbound auth) or NEXT_PUBLIC_* vars.

# --- Database (Supabase Postgres) ---
# The worker is long-lived → use the DIRECT/session connection, port 5432.
DATABASE_URL=postgres://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres

# --- Queue (Redis + BullMQ, TLS) ---
REDIS_URL=rediss://default:<password>@<vps-host>:6379

# --- App ---
# Must match the web tier so signed unsubscribe links verify and resolve.
UNSUBSCRIBE_SECRET=
APP_URL=https://day3.app

# --- Supabase Storage (reads uploaded CSVs during imports) ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Amazon SES v2) ---
EMAIL_PROVIDER=mock          # mock | ses
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=day3-default

# Campaign risk review mode (deterministic checks always run; "mock" = no AI).
AI_REVIEW_MODE=mock
