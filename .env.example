# Web tier (Next.js on Vercel). Copy to `.env.local` for local dev; set the same
# keys in the Vercel project env store for deploys. Never commit real secrets.

# --- Clerk (auth / organizations / billing) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Clerk webhook signing secret (organization.* + subscriptionItem.* events).
# REQUIRED — startup validation (src/lib/env.ts) refuses to boot without it.
# For local dev without a Clerk tunnel, set any >=16-char placeholder (billing
# state is also mirrored on dashboard load, so webhooks aren't needed locally).
CLERK_WEBHOOK_SIGNING_SECRET=

# --- App ---
# Public base URL of the web app. Used to render unsubscribe links etc.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated admin email addresses (admin routes).
ADMIN_EMAILS=you@example.com

# --- Public signup forms ---
# Public forms live under /f on the app domain (e.g. https://go.day3.app/f/<id>),
# NOT on a separate host. FORMS_URL is the absolute base for form links built
# off-request (the worker's confirmation email, dashboard install snippets).
# Defaults to APP_URL when unset — only set this if forms are served from a
# different base than the app.
# FORMS_URL=http://localhost:3000

# --- Secrets (REQUIRED — the app refuses to start without them) ---
# Validated at startup by src/lib/env.ts: each must be at least 16 characters,
# and the signers throw rather than fall back to an empty key. Generate strong
# random values; never commit real ones.
#
# Signs unsubscribe / one-click (RFC 8058) HMAC tokens. MUST match the worker.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=
# Signs the short-lived Cloudflare OAuth state cookie (CSRF protection).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=
# AES-256 key (base64 of 32 raw bytes) encrypting Cloudflare DNS tokens at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Single-key form. Ciphertext is tagged with key id "v1". For key ROTATION use
# the keyring form below instead (set EITHER this OR DNS_TOKEN_ENC_KEYS).
DNS_TOKEN_ENC_KEY=
# Rotation-aware keyring: comma-separated `id:base64key` pairs. Every listed key
# can DECRYPT; DNS_TOKEN_ENC_ACTIVE_KEY_ID picks which ENCRYPTS new tokens. To
# rotate: add the new key here, point the active id at it, deploy, then run
# `npm run keys:rotate-dns`, then drop the retired key. See docs/cloudflare-dns-oauth.md.
# DNS_TOKEN_ENC_KEYS=v1:<base64>,v2:<base64>
# DNS_TOKEN_ENC_ACTIVE_KEY_ID=v2

# --- Database (Supabase Postgres) ---
# Vercel (serverless) → transaction pooler, port 6543 (prepare:false is auto).
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations only (drizzle-kit migrate/push/studio) → session connection, port 5432.
# The transaction pooler (6543) can't run migrations. Same URL, port 5432.
# drizzle.config.ts loads .env.local and prefers DIRECT_URL, falling back to DATABASE_URL.
DIRECT_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase Storage (CSV imports; replaces R2) ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Queue (Redis + BullMQ on the VPS, TLS) ---
# The producer side (API routes enqueue jobs). Use the rediss:// URL + ACL cred.
# Also backs the request rate limiter (src/lib/rate-limit.ts).
REDIS_URL=rediss://default:<password>@<vps-host>:6379

# --- Rate limiting (optional; safe defaults in src/lib/rate-limit.ts) ---
# Per-window throttles on sensitive endpoints. Format "<limit>/<windowSeconds>".
# Keyed by account_id (or client IP for the public unsubscribe route). The
# limiter fails OPEN if Redis is unreachable (logs the condition). Defaults:
#   RATE_LIMIT_IMPORT=10/60           # CSV import (5 MB upload + queue job)
#   RATE_LIMIT_CAMPAIGN_CREATE=30/60  # POST /api/campaigns
#   RATE_LIMIT_TEST_EMAIL=5/60        # test-email (real SES send)
#   RATE_LIMIT_CAMPAIGN_SUBMIT=20/60  # campaign submit → review pipeline
#   RATE_LIMIT_UNSUBSCRIBE=60/60      # public unsubscribe (keyed by IP)
#   RATE_LIMIT_OAUTH_CONNECT=20/60    # Cloudflare OAuth connect start

# --- Observability (optional; see src/lib/logger.ts) ---
# Structured JSON logging is always on. LOG_LEVEL gates verbosity
# (debug|info|warn|error; default info). ERROR_REPORTING_DSN (or SENTRY_DSN)
# turns on the error sink: unhandled route 500s and failed jobs are POSTed there
# as redacted JSON (stack + safe context, never secrets). Unset → no-op.
# LOG_LEVEL=info
# ERROR_REPORTING_DSN=

# --- Email (Amazon SES v2) ---
EMAIL_PROVIDER=mock          # mock | ses  (keep mock until SES is wired/verified)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=day3-default
# SNS topic the SES config set publishes delivery/bounce/complaint events to.
# Required when EMAIL_PROVIDER=ses: the inbound webhook rejects any notification
# whose TopicArn doesn't match this value.
SES_SNS_TOPIC_ARN=arn:aws:sns:eu-north-1:123456789012:day3-ses-events

# --- AI assist (OpenRouter) — OPTIONAL ---
# Powers the campaign drafting/assist helpers (draft from a brief, subject ideas,
# auto preview text, rewrite selection). Leave OPENROUTER_API_KEY unset to disable
# the feature entirely — the app boots and runs exactly as before, and the AI UI
# is hidden. Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
# Model slug to use. Defaults to anthropic/claude-sonnet-4.6 when unset.
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# --- AI usage budget (optional; safe defaults in src/lib/ai-budget.ts) ---
# Caps paid AI spend PER ORGANIZATION so a busy/runaway account can't burn the
# plan margin. Metered from real token usage; 1 credit = $0.01 of AI spend.
# Surfaced to users as a % + a subtle "resets in Xh Ym"; when spent, the AI
# helpers disable until the window (or month) resets. Like the rate limiter, it
# fails OPEN if Redis is unreachable. Defaults shown below.
#   AI_BUDGET_WINDOW_HOURS=5        # rolling reset window (anchored to first use)
#   AI_BUDGET_WINDOW_CREDITS=30     # $0.30 per org per window (the visible meter)
#   AI_BUDGET_MONTHLY_CREDITS=200   # $2.00 per org per calendar month; 0 disables
# Token prices used to convert usage → cost (USD per million tokens). Match these
# to OPENROUTER_MODEL's pricing. Defaults are Claude Sonnet 4.6.
#   AI_PRICE_INPUT_PER_MTOK=3
#   AI_PRICE_OUTPUT_PER_MTOK=15
