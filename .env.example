# Web tier (Next.js on Vercel). Copy to `.env.local` for local dev; set the same
# keys in the Vercel project env store for deploys. Never commit real secrets.

# --- Clerk (auth / organizations / billing) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Clerk webhook signing secret (organization.* + subscriptionItem.* events).
# Optional locally (Clerk can't reach localhost without a tunnel; billing state
# is also mirrored on dashboard load). Set for prod.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- App ---
# Public base URL of the web app. Used to render unsubscribe links etc.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated admin email addresses (admin routes).
ADMIN_EMAILS=you@example.com
# Long random string used to sign unsubscribe tokens. MUST match the worker.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UNSUBSCRIBE_SECRET=

# --- Database (Supabase Postgres) ---
# Vercel (serverless) → transaction pooler, port 6543 (prepare:false is auto).
DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Supabase Storage (CSV imports; replaces R2) ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Queue (Redis + BullMQ on the VPS, TLS) ---
# The producer side (API routes enqueue jobs). Use the rediss:// URL + ACL cred.
REDIS_URL=rediss://default:<password>@<vps-host>:6379

# --- Email (Amazon SES v2) ---
EMAIL_PROVIDER=mock          # mock | ses  (keep mock until SES is wired/verified)
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=day3-default
