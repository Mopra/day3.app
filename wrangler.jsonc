{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "day3-app",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newsletter_mvp",
      // Replace after `wrangler d1 create newsletter_mvp`. Local dev works
      // without a real id.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "IMPORTS_BUCKET",
      "bucket_name": "newsletter-imports"
    }
  ],

  "queues": {
    "producers": [{ "binding": "JOBS_QUEUE", "queue": "newsletter-jobs" }],
    "consumers": [
      {
        "queue": "newsletter-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "newsletter-jobs-dlq"
      }
    ]
  },

  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // Enable when switching EMAIL_PROVIDER to "cloudflare":
  // "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "APP_URL": "http://localhost:5173",
    "AI_REVIEW_MODE": "mock",
    "EMAIL_PROVIDER": "mock"
  },

  "observability": {
    "enabled": true
  }
}
